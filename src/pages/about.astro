---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Career from "@/components/Career.astro";
import { TAGLINE } from "@/data/site";
---

<SiteLayout title="About · Ryan Saxe" description={TAGLINE} section="about">
  <h1 class="vh">About</h1>
  <div class="about">
    <Career />
    <section class="bio" aria-labelledby="bio-h">
      <h2 id="bio-h" class="vh">Introduction</h2>
      <div class="parts">
        <section>
          <h3>Leading</h3>
          <p>
            I think the people who lead technical teams should keep building, and I try to lead that way. The part of the
            job I care about most is growing people, from teaching scientists to build machine learning from first
            principles, autodiff to transformers, to helping engineers grow into principals.
          </p>
        </section>
        <section>
          <h3>Building</h3>
          <p>
            Most of what I build comes back to one idea: machine learning should be something people can understand.
            Outside work I designed the machine learning behind CubeCobra’s recommendations and draft bots, and built a
            transformer that drafts Magic: The Gathering well enough to reach #27 on the Arena ladder. Lately I build tools
            for working with AI agents, like pair and byor.
          </p>
        </section>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  /* The card switches to one column when the page is narrow. */
  .about {
    container: about / inline-size;
    padding: 0 var(--g);
  }
  /* beside the header's card, the profile card's top lines up with it, and the cards grow no wider than 1216px */
  @media (min-width: 1024px) {
    .about {
      margin-top: -14px;
      padding-left: var(--g-left);
      max-width: calc(var(--g-left) + 1216px + var(--g));
    }
  }
  /*
   * The introduction is a second card under the profile, the same width: two parts side by side, split
   * by a hairline, each under a small label. The profile above already lists every role, so the parts
   * say what the list can't: what Ryan has led, and what he builds.
   */
  .bio {
    margin-top: 20px;
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--card-shadow);
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .parts section {
    padding: 30px 40px 34px;
  }
  .parts section:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .parts section:nth-child(n + 3) {
    border-top: 1px solid var(--line);
  }
  .parts h3 {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 18px;
    font-weight: 500;
    color: var(--muted);
  }
  .parts p {
    margin: 0;
    font-size: 15px;
    line-height: 25px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  @container about (max-width: 760px) {
    .bio {
      margin-top: 14px;
    }
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }
    .parts section {
      padding: 22px 20px 24px;
    }
    .parts section:nth-child(odd) {
      border-right: 0;
    }
    .parts section + section {
      border-top: 1px solid var(--line);
    }
    .parts p {
      font-size: 14.5px;
      line-height: 24px;
    }
  }
</style>
