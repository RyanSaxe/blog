---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Intro from "@/components/Intro.astro";
import Career from "@/components/Career.astro";
---

<SiteLayout
  title="About · Ryan Saxe"
  description="I design large, interpretable machine learning and AI systems. I’m Global Director, Data & Analytics, and Head of Science and Engineering at AB InBev."
  section="about"
>
  <div class="about">
    <div class="top">
      <Intro heading>
        I’m Ryan Saxe.
        <Fragment slot="rest">I design large, interpretable machine learning and AI systems, and I build tools for working with AI agents.</Fragment>
      </Intro>
    </div>
    <Career />
    <figure class="portrait">
      <img
        src="/images/about/ryan-saxe-720.webp"
        width="720"
        height="900"
        alt="Portrait of Ryan Saxe"
        decoding="async"
      />
    </figure>
  </div>
</SiteLayout>

<style>
  /*
   * The Intro spans the page exactly as it does on every other page. On wide screens the portrait
   * fills the space the Intro leaves on the right and runs down beside the career card; narrower,
   * it sits beside the card; on a phone it follows the card.
   */
  .about {
    --pw: 380px;
    display: grid;
    grid-template-columns: var(--g) minmax(0, 1fr) 20px var(--pw) var(--g);
    grid-template-rows: auto auto;
  }
  .top {
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .about > :global(.career) {
    grid-column: 2;
    grid-row: 2;
  }
  .portrait {
    position: relative;
    grid-column: 4;
    grid-row: 1 / 3;
    /* Level with the Intro's first line: Intro.astro pads its top by 36px. */
    margin: 36px 0 0;
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--card-shadow);
  }
  .portrait img {
    position: absolute;
    inset: 8px;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 10px;
    background: var(--plate);
  }

  /* Below this width the Intro's 760px line would run under the portrait. */
  @media (max-width: 1259px) {
    .about {
      --pw: 28%;
    }
    .portrait {
      grid-row: 2;
      margin-top: 0;
    }
  }

  @media (max-width: 859px) {
    .about {
      grid-template-columns: var(--g) minmax(0, 1fr) var(--g);
      grid-template-rows: auto auto auto;
    }
    .portrait {
      grid-column: 2;
      grid-row: 3;
      width: 100%;
      max-width: 480px;
      margin-top: 14px;
      aspect-ratio: 4 / 3;
    }
    .portrait img {
      object-position: 50% 25%;
    }
  }
</style>
