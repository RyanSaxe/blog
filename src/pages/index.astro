---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Rail from "@/components/Rail.astro";
import Panel from "@/components/Panel.astro";
import Intro from "@/components/Intro.astro";
import { projects } from "@/data/projects";
import { writing } from "@/data/writing";
import { WRITING } from "@/data/site";
---

<SiteLayout
  title="Ryan Saxe"
  description="I lead science and engineering for AB InBev's global analytics and build tools for working with AI agents."
>
  <Intro face>
    I’m <a class="me" href="/about/">Ryan Saxe</a>.
    <Fragment slot="rest">I lead science and engineering for AB&nbsp;InBev’s global analytics and build tools for working with AI agents.</Fragment>
  </Intro>

  <Rail id="projects" title="Projects" items={projects} allHref="/projects/" allLabel="All projects" eager />
  <Rail id="writing" title={WRITING.name} items={writing} allHref={WRITING.path} allLabel="All writing" />

  <Panel />
</SiteLayout>
