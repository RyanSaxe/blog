---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Rail from "@/components/Rail.astro";
import Panel from "@/components/Panel.astro";
import Intro from "@/components/Intro.astro";
import { projects } from "@/data/projects";
import { writing } from "@/data/writing";
import { TAGLINE, WRITING } from "@/data/site";
---

<SiteLayout title="Ryan Saxe" description={TAGLINE}>
  <Intro />

  <div data-fit>
    <Rail id="projects" title="Projects" items={projects} allHref="/projects/" allLabel="All projects" eager />
    <Rail id="writing" title={WRITING.name} items={writing} allHref={WRITING.path} allLabel="All writing" eager />
  </div>

  <!--
    Sizes the rows so the first screen always shows the Writing heading and the top of its cards.
    Tall windows keep the designed sizes. On a shorter one the spacing tightens first, by only as
    much as it needs, then the images crop from 3:2 toward 2:1, then the cards narrow; on very short windows the cards drop their
    fact line and narrow further. A window far too short for any of that, such as a phone on its side, keeps the designed sizes.
    It runs before
    the first paint, again once the fonts load, and whenever the window's width or height changes,
    or after a panel closes if the window changed while it was open.
  -->
  <script is:inline>
    (() => {
      const PEEK = 36; // pixels of the Writing cards in view
      const root = document.documentElement;
      const shelves = [...document.querySelectorAll("[data-fit] .shelf")];
      const target = document.querySelector("#writing .card");
      // 100svh ignores the iPhone toolbar collapsing, so scrolling never resizes the rows
      const probe = document.createElement("div");
      probe.style.cssText = "position:absolute;top:0;left:0;width:0;height:100svh;visibility:hidden;pointer-events:none";
      document.body.append(probe);

      const over = () => target.getBoundingClientRect().top + scrollY + PEEK - probe.offsetHeight;
      // 0 keeps the designed spacing, 1 is the tightest; every spacing it changes is linear in it
      const tighten = (t) => (t ? root.style.setProperty("--fit-t", t) : root.style.removeProperty("--fit-t"));
      const set = (cw, coverH, compact = false) => {
        for (const s of shelves) {
          s.classList.toggle("compact", compact);
          s.classList.toggle("fitted", !!coverH);
          if (cw) s.style.setProperty("--cw", `${cw}px`);
          else s.style.removeProperty("--cw");
          if (coverH) s.style.setProperty("--cover-h", `${coverH}px`);
          else s.style.removeProperty("--cover-h");
        }
      };
      const shrink = (compact, minW) => {
        // narrower cards can wrap their text onto another line, so measure again after each step
        for (let i = 0; i < 3; i++) {
          const d = over();
          if (d <= 0) return;
          const card = shelves[0].querySelector(".card");
          const cw = card.offsetWidth;
          const coverH = card.querySelector(".cover").offsetHeight - d;
          if (coverH >= (cw - 16) / 2) set(cw, Math.floor(coverH), compact);
          else {
            const w = Math.max(minW, Math.floor(2 * coverH + 16));
            set(w, (w - 16) / 2, compact);
          }
        }
      };
      const fit = () => {
        tighten(0);
        set(0, 0);
        const d0 = over();
        if (d0 <= 0) return;
        tighten(1);
        const d1 = over();
        if (d1 <= 0) return tighten(d0 / (d0 - d1));
        const phone = innerWidth <= 640;
        shrink(false, phone ? 240 : 260);
        if (over() <= 0) return;
        const card = shelves[0].querySelector(".card");
        set(card.offsetWidth, card.querySelector(".cover").offsetHeight, true);
        shrink(true, phone ? 200 : 220);
        // shrinking only costs quality when the row still ends up far out of view
        if (over() > 60) {
          tighten(0);
          set(0, 0);
        }
      };

      let size = "";
      const refit = () => {
        const now = `${innerWidth}x${probe.offsetHeight}`;
        // an open panel holds the card's position for its closing animation
        const overlay = document.getElementById("overlay");
        if (now === size || (overlay && !overlay.hidden)) return;
        size = now;
        fit();
      };
      refit();
      document.fonts?.ready.then(() => {
        size = "";
        refit();
      });
      addEventListener("resize", refit);
      addEventListener("panel:closed", refit);
    })();
  </script>

  <Panel />
</SiteLayout>

<style is:global>
  [data-fit] .shelf.fitted .cover {
    aspect-ratio: auto;
    height: var(--cover-h);
  }
  [data-fit] .shelf.compact .m {
    display: none;
  }
  /* The space below the opening line is not tightened here: Intro sets it from the window's height on every page. */
  html[style*="--fit-t"] [data-fit] .shelf + .shelf {
    margin-top: calc(64px - 28px * var(--fit-t));
  }
  html[style*="--fit-t"] [data-fit] .ticks {
    margin-top: calc(20px - 12px * var(--fit-t));
  }
  @media (max-width: 640px) {
    html[style*="--fit-t"] [data-fit] .shelf + .shelf {
      margin-top: calc(48px - 16px * var(--fit-t));
    }
    html[style*="--fit-t"] [data-fit] .ticks {
      margin-top: calc(18px - 8px * var(--fit-t));
    }
  }
</style>
