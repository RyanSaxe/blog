---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  const link = (post?: (typeof posts)[number]) =>
    post && { title: post.data.title, description: post.data.description, href: `/blog/${post.id}/` };
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: link(posts[i - 1]), next: link(posts[i + 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const body = post.body || "";
const plainText = body
  .replace(/---[\s\S]*?---/, "")
  .replace(/```[\s\S]*?```/g, "")
  .replace(/\$\$[\s\S]*?\$\$/g, "")
  .replace(/\$[^$]+\$/g, "")
  .replace(/<[^>]+>/g, "")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[\^[^\]]+\]/g, "")
  .replace(/\[\^[^\]]+\]:.*/g, "");
const wordCount = plainText.split(/\s+/).filter((w) => w.length > 0).length;
const readingTime = Math.max(1, Math.round(wordCount / 225));
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  heroImage={post.data.heroImage}
  headings={headings}
  readingTime={readingTime}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
