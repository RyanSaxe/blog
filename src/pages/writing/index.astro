---
import SiteLayout from "@/layouts/SiteLayout.astro";
import CardGrid from "@/components/CardGrid.astro";
import { writing } from "@/data/writing";
import { WRITING } from "@/data/site";

const description = `${WRITING.subtitle}, on machine learning and on Magic: The Gathering.`;
---

<SiteLayout title={`${WRITING.name} · Ryan Saxe`} description={description} section="writing">
  <CardGrid items={writing} label={WRITING.name} />
</SiteLayout>
