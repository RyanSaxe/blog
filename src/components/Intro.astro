---
// The opening block of every page: one line in the landing hook's type, a dark lead and a muted rest,
// at the same distance below the header everywhere. Pages pass the lead in the default slot and
// the muted continuation in the `rest` slot.
interface Props {
  face?: boolean;
  heading?: boolean;
  label?: string;
}
const { face = false, heading = false, label = "Introduction" } = Astro.props;
const Text = heading ? "h1" : "p";
---

<section class="intro" aria-label={heading ? undefined : label}>
  <Text class="intro-text">
    {face && <img class="face" src="/images/site/face.webp" alt="" width="96" height="96" />}<slot />
    {Astro.slots.has("rest") && <span class="rest"><slot name="rest" /></span>}
  </Text>
</section>

<style>
  .intro {
    padding: 36px var(--g) 52px;
  }
  .intro-text {
    margin: 0;
    max-width: 760px;
    font-size: 23px;
    line-height: 32px;
    font-weight: 500;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
  }
  .rest {
    color: var(--muted);
  }
  .intro-text :global(a.me) {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--ink) 22%, transparent);
    transition: text-decoration-color 0.2s var(--ease);
  }
  .intro-text :global(a.me:hover) {
    text-decoration-color: var(--ink);
  }
  .face {
    display: inline-block;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    vertical-align: -7px;
    margin-right: 10px;
    box-shadow: 0 0 0 1px var(--edge);
  }
  @media (max-width: 640px) {
    .intro {
      padding: 24px var(--g) 36px;
    }
    .intro-text {
      font-size: 19px;
      line-height: 27px;
      letter-spacing: -0.014em;
    }
    .face {
      width: 26px;
      height: 26px;
      vertical-align: -6px;
      margin-right: 8px;
    }
  }
</style>
