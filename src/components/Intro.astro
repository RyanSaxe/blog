---
// The opening of the landing, Projects, Writing and About pages: the same line everywhere, at the
// same distance below the header. The muted part is a hook: clicking it, or the round button after
// its last word, opens a short paragraph in a panel that grows out of the button, the way a card
// opens. The page includes Panel, which opens it.
import { TAGLINE, TAGLINE_MORE } from "@/data/site";

interface Props {
  /** The page's h1, as on About; elsewhere the line is a paragraph. */
  heading?: boolean;
  /** The name links to About everywhere except on About itself. */
  linkName?: boolean;
}
const { heading = false, linkName = true } = Astro.props;
const Text = heading ? "h1" : "p";
// The last word and the button share a line, so the button never sits alone.
const cut = TAGLINE.lastIndexOf(" ") + 1;
// As a heading, its name is the line alone, without the button's label.
const name = heading ? `I’m Ryan Saxe. ${TAGLINE}` : undefined;
---

<section class="intro" aria-label={heading ? undefined : "Introduction"}>
  <Text class="intro-text" aria-label={name}>
    I’m {linkName ? <a class="me" href="/about/">Ryan Saxe</a> : "Ryan Saxe"}.
    <span class="rest hook" data-hook>{TAGLINE.slice(0, cut)}<span class="tail">{TAGLINE.slice(cut)}<button class="plus" type="button" aria-expanded="false" aria-haspopup="dialog" aria-label="More about me"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 2.75v6.5M2.75 6h6.5"></path></svg></button></span></span>
  </Text>
  <template data-intro-panel>
    <div class="p-in solo">
      <div class="p-bar"><span class="grab"></span></div>
      <div class="p-txt">
        <h2 class="t p-t" id="pTitle">Ryan Saxe</h2>
        <p class="s p-s">{TAGLINE}</p>
        <div class="rest">
          <hr />
          <p>{TAGLINE_MORE}</p>
          {
            linkName && (
              <div class="actions">
                <a class="btn" href="/about/">
                  More about me
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M2 6h7.5M6.5 3l3 3-3 3" />
                  </svg>
                </a>
              </div>
            )
          }
        </div>
      </div>
      <button class="x p-close" type="button" aria-label="Close">
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7"></path></svg>
      </button>
    </div>
  </template>
</section>

<style>
  /* The space below tightens on short windows, the same on every page, so the rows under it line up across pages. */
  .intro {
    padding: 36px var(--g) clamp(28px, 12svh - 56px, 52px);
  }
  .intro-text {
    margin: 0;
    max-width: 760px;
    font-size: 23px;
    line-height: 32px;
    font-weight: 500;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
  }
  .intro-text :global(a.me) {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--ink) 22%, transparent);
    transition: text-decoration-color 0.2s var(--ease);
  }
  .intro-text :global(a.me:hover) {
    text-decoration-color: var(--ink);
  }
  .hook {
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .hook:hover,
  .hook:has([aria-expanded="true"]) {
    color: var(--ink-2);
  }
  .tail {
    white-space: nowrap;
  }
  .plus {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-left: 10px;
    vertical-align: 2px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--edge-2);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .plus svg {
    width: 12px;
    height: 12px;
  }
  .hook:hover .plus {
    background: var(--card);
    color: var(--ink);
  }
  .plus:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  @media (max-width: 640px) {
    .intro {
      padding: 24px var(--g) clamp(24px, 6svh - 16px, 36px);
    }
    .intro-text {
      font-size: 19px;
      line-height: 27px;
      letter-spacing: -0.014em;
    }
    .plus {
      width: 24px;
      height: 24px;
      margin-left: 8px;
      vertical-align: 1px;
    }
  }
</style>
