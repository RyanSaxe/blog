---
import { imgSet, imgSrc, type Pic } from "@/data/cards";

interface Props {
  pic: Pic;
  sizes: string;
  eager?: boolean;
  class?: string;
  alt?: string;
}
const { pic, sizes, eager = false, class: cls, alt = pic.alt } = Astro.props;
---

<picture class={cls}>
  {pic.dark && <source data-dark media="(prefers-color-scheme: dark)" srcset={imgSet(pic.name + "-dark")} sizes={sizes} />}
  <img
    src={imgSrc(pic.name, 800)}
    srcset={imgSet(pic.name)}
    sizes={sizes}
    width="1200"
    height="800"
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    draggable="false"
  />
</picture>
