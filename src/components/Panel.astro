---
/*
 * The dialog every card opens, plus the carousel behavior. Include once per page that has cards or
 * the opening line. On a laptop the card's image grows into a centered panel; on a phone, a tablet
 * held upright or a phone on its side it grows into a full-screen sheet. The opening line's round button grows the same way into a
 * smaller panel, or a sheet as tall as its text. All use one critically damped spring and reverse
 * exactly on close.
 */
import "@/styles/cards.css";
---

<div class="overlay" id="overlay" hidden>
  <div class="dim" id="dim"></div>
  <div class="frame" id="frame" role="dialog" aria-modal="true" aria-labelledby="pTitle">
    <div class="content" id="content"></div>
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { onPage } from "@/scripts/page";

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

  // The panel's elements on the page in view; onPage finds them again after each page swap.
  let overlay: HTMLElement, dim: HTMLElement, frame: HTMLElement, content: HTMLElement;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const narrow = matchMedia("(max-width: 900px), (max-height: 500px)"); // the sheet's media query in cards.css
  const isDark = () => document.documentElement.dataset.theme === "dark";

  /* ---------- motion ---------- */
  /* One critically damped spring, solved exactly so any frame time gives the same pose. */
  class Spring {
    x: number; v = 0; w: number; eps: number; done = true; target: number; x0 = 0; v0 = 0; t0 = 0;
    constructor(x: number, omega = 21, eps = 1e-3) { this.x = this.target = x; this.w = omega; this.eps = eps; }
    to(target: number, now: number, v0?: number) {
      if (!this.done) this.sample(now); else if (v0 == null) this.v = 0;
      if (v0 != null) this.v = v0;
      this.x0 = this.x; this.v0 = this.v; this.t0 = now; this.target = target; this.done = false;
    }
    jump(x: number) { this.x = this.target = x; this.v = 0; this.done = true; }
    sample(now: number) {
      if (this.done) return;
      const t = Math.max(0, now - this.t0) / 1000, w = this.w;
      const c1 = this.x0 - this.target, c2 = this.v0 + w * c1, e = Math.exp(-w * t);
      this.x = this.target + (c1 + c2 * t) * e;
      this.v = (c2 - w * (c1 + c2 * t)) * e;
      if (Math.abs(this.x - this.target) < this.eps && Math.abs(this.v) < this.eps * 20) { this.x = this.target; this.v = 0; this.done = true; }
    }
  }
  const OMEGA = 21; // settles in about 350 ms with no overshoot
  type Job = (now: number) => boolean;
  const jobs = new Set<Job>(); let rafId = 0;
  const run = (fn: Job) => { jobs.add(fn); if (!rafId) rafId = requestAnimationFrame(tick); };
  const stop = (fn: Job) => { jobs.delete(fn); };
  function tick(now: number) {
    for (const fn of [...jobs]) if (fn(now)) jobs.delete(fn);
    rafId = jobs.size ? requestAnimationFrame(tick) : 0;
  }
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const smooth = (a: number, b: number, x: number) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
  const px = (v: string) => parseFloat(v) || 0;

  /* ---------- carousels ---------- */
  class Rail {
    el: HTMLElement; cards: HTMLElement[]; hits: HTMLButtonElement[]; prev: HTMLElement; next: HTMLElement; ticks: HTMLElement[];
    sp = new Spring(0, 15, 0.5); glideFn: Job | null = null; drag = false; raf = 0;
    constructor(sec: HTMLElement, signal: AbortSignal) {
      this.el = $(".rail", sec); this.cards = $$(".card", this.el); this.hits = this.cards.map((c) => $<HTMLButtonElement>(".hit", c));
      this.prev = $(".prev", sec); this.next = $(".next", sec); this.ticks = $$(".ticks i", sec);
      this.setFocus(0);
      this.el.addEventListener("scroll", () => this.onScroll(), { passive: true });
      this.prev.addEventListener("click", () => this.page(-1));
      this.next.addEventListener("click", () => this.page(1));
      for (const ev of ["wheel", "touchstart"]) this.el.addEventListener(ev, () => this.cancelGlide(), { passive: true });
      this.el.addEventListener("keydown", (e) => this.key(e));
      this.hits.forEach((h, i) => h.addEventListener("focus", () => this.setFocus(i)));
      this.dragSetup(signal);
      addEventListener("resize", () => this.update(), { signal });
      this.update();
    }
    padL() { return px(getComputedStyle(this.el).paddingLeft); }
    snapX(i: number) { return this.cards[i].offsetLeft - this.padL(); }
    max() { return this.el.scrollWidth - this.el.clientWidth; }
    nearest(x: number) { let b = 0; this.cards.forEach((_, i) => { if (Math.abs(this.snapX(i) - x) < Math.abs(this.snapX(b) - x)) b = i; }); return b; }
    perPage() { const c = this.cards[0]; return Math.max(1, Math.floor((this.el.clientWidth - this.padL() + 4) / (c.offsetWidth + px(getComputedStyle(this.el).columnGap)))); }
    page(dir: number) {
      if ((dir < 0 ? this.prev : this.next).getAttribute("aria-disabled") === "true") return;
      const from = this.glideFn ? this.sp.target : this.el.scrollLeft;
      const i = clamp(this.nearest(Math.min(from, this.max())) + dir * this.perPage(), 0, this.cards.length - 1);
      this.glide(Math.min(this.snapX(i), this.max()));
    }
    glide(target: number, v0?: number) {
      target = clamp(target, 0, this.max());
      if (reduced.matches) { this.el.scrollLeft = target; return; }
      if (!this.glideFn) this.sp.jump(this.el.scrollLeft);
      this.el.style.scrollSnapType = "none";
      this.sp.to(target, performance.now(), v0);
      if (!this.glideFn) {
        this.glideFn = (now) => {
          this.sp.sample(now); this.el.scrollLeft = this.sp.x;
          if (this.sp.done) { this.el.scrollLeft = this.sp.target; this.glideFn = null; this.releaseSnap(); return true; }
          return false;
        };
        run(this.glideFn);
      }
    }
    cancelGlide() { if (this.glideFn) { stop(this.glideFn); this.glideFn = null; this.releaseSnap(); } }
    releaseSnap() { if (!this.glideFn && !this.drag) this.el.style.scrollSnapType = ""; }
    onScroll() { if (!this.raf) this.raf = requestAnimationFrame(() => { this.raf = 0; this.update(); }); }
    update() {
      const sl = this.el.scrollLeft, vw = this.el.clientWidth, max = this.max();
      this.cards.forEach((c, i) => {
        const a = c.offsetLeft, b = a + c.offsetWidth;
        this.ticks[i]?.classList.toggle("on", (Math.min(b, sl + vw) - Math.max(a, sl)) / c.offsetWidth > 0.55);
      });
      this.prev.setAttribute("aria-disabled", String(sl <= 2));
      this.next.setAttribute("aria-disabled", String(sl >= max - 2));
    }
    setFocus(i: number) { this.hits.forEach((h, j) => { h.tabIndex = j === i ? 0 : -1; }); }
    reveal(i: number) {
      const c = this.cards[i], sl = this.glideFn ? this.sp.target : this.el.scrollLeft;
      const a = c.offsetLeft, b = a + c.offsetWidth, vw = this.el.clientWidth;
      if (a < sl + this.padL() - 1) this.glide(this.snapX(i));
      else if (b > sl + vw - 24) {
        const need = b - (vw - 24);
        let j = 0; while (j < i && this.snapX(j) < need - 1) j++;
        this.glide(this.snapX(j));
      }
    }
    key(e: KeyboardEvent) {
      const i = this.hits.indexOf(document.activeElement as HTMLButtonElement); if (i < 0) return;
      const j = e.key === "ArrowRight" ? Math.min(i + 1, this.cards.length - 1) : e.key === "ArrowLeft" ? Math.max(i - 1, 0)
        : e.key === "Home" ? 0 : e.key === "End" ? this.cards.length - 1 : null;
      if (j == null) return;
      e.preventDefault();
      this.setFocus(j); this.hits[j].focus({ preventScroll: true }); this.reveal(j);
    }
    /* mouse drag; touch and trackpads use native scrolling */
    dragSetup(signal: AbortSignal) {
      const el = this.el;
      let d: { x0: number; sl0: number; moved: boolean; s: [number, number][] } | null = null, suppress = false;
      el.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        d = { x0: e.clientX, sl0: el.scrollLeft, moved: false, s: [[e.timeStamp, el.scrollLeft]] };
      });
      addEventListener("pointermove", (e) => {
        if (!d) return;
        const dx = e.clientX - d.x0;
        if (!d.moved) {
          if (Math.abs(dx) < 5) return;
          d.moved = true; this.drag = true; this.cancelGlide();
          el.style.scrollSnapType = "none"; el.classList.add("dragging");
        }
        el.scrollLeft = d.sl0 - dx;
        d.s.push([e.timeStamp, el.scrollLeft]); if (d.s.length > 6) d.s.shift();
      }, { signal });
      const end = () => {
        if (!d) return;
        const was = d; d = null;
        if (!was.moved) return;
        this.drag = false; el.classList.remove("dragging"); suppress = true;
        setTimeout(() => { suppress = false; }, 0);
        const a = was.s[0], b = was.s[was.s.length - 1];
        const v = (b[1] - a[1]) / Math.max(16, b[0] - a[0]);
        let i = this.nearest(el.scrollLeft + v * 220);
        const now = this.nearest(el.scrollLeft);
        if (Math.abs(v) > 0.25 && i === now) i = clamp(now + Math.sign(v), 0, this.cards.length - 1);
        const target = Math.min(this.snapX(i), this.max()), dist = target - el.scrollLeft, vs = v * 1000;
        // keep the release velocity only while it points at the target and cannot overshoot it
        const v0 = Math.sign(vs) === Math.sign(dist) ? Math.sign(vs) * Math.min(Math.abs(vs), Math.abs(dist) * this.sp.w) : 0;
        this.glide(target, v0);
      };
      addEventListener("pointerup", end, { signal }); addEventListener("pointercancel", end, { signal });
      el.addEventListener("click", (e) => { if (suppress) { e.stopPropagation(); e.preventDefault(); } }, true);
    }
  }
  let rails: Rail[] = [];
  const railOf = (card: HTMLElement) => rails.find((r) => r.cards.includes(card));

  /* ---------- the panel ---------- */
  type Part = { ce: HTMLElement; pe: HTMLElement; k: number; C: DOMRect | R; L: R };
  type R = { x: number; y: number; w: number; h: number };
  const rect = (el: Element): R => { const r = el.getBoundingClientRect(); return { x: r.left, y: r.top, w: r.width, h: r.height }; };
  const snapR = (r: R): R => { const x = Math.round(r.x), y = Math.round(r.y); return { x, y, w: Math.round(r.x + r.w) - x, h: Math.round(r.y + r.h) - y }; };
  const lerpRect = (a: R, b: R, t: number): R => ({ x: lerp(a.x, b.x, t), y: lerp(a.y, b.y, t), w: lerp(a.w, b.w, t), h: lerp(a.h, b.h, t) });
  const fs = (el: Element) => parseFloat(getComputedStyle(el).fontSize);

  let S: any = null;
  // An open panel has its own history entry, so Back closes it instead of leaving the page.
  let pushed = false;
  // set while closing steps back over the panel's entry, so that step is not taken for a page change
  let steppingBack = false;
  const unpush = () => {
    if (pushed) { pushed = false; steppingBack = true; history.back(); }
  };
  const inertTargets = () => [...document.body.children].filter((el) => el !== overlay && el.tagName !== "SCRIPT") as HTMLElement[];

  // `from` is a card, or the opening line's round button, which grows into a panel of text alone
  function openPanel(from: HTMLElement, trigger: HTMLElement, tpl: HTMLTemplateElement) {
    if (S && !S.closing) return;
    if (S) finish(true);
    const card = from.classList.contains("card") ? from : null;
    const phone = narrow.matches;
    const head = phone ? 56 : 64;
    const cr0 = rect(from);
    if (cr0.y < head + 8) window.scrollBy(0, cr0.y - head - 8);
    const rail = card && railOf(card);
    if (rail) rail.reveal(rail.cards.indexOf(card!));

    content.replaceChildren(tpl.content.cloneNode(true));
    overlay.hidden = false;
    overlay.style.visibility = "hidden";
    document.documentElement.style.overflow = "hidden"; // the page behind does not scroll
    const W = overlay.clientWidth, H = overlay.clientHeight;
    const PW = Math.min(card ? 1106 : 600, W - 64);
    const P: R = phone ? { x: 0, y: 10, w: W, h: H - 10 } : { x: Math.round((W - PW) / 2), y: 0, w: PW, h: 0 };
    frame.style.transform = `translate(${P.x}px, ${P.y}px)`;
    frame.style.width = P.w + "px";
    frame.style.height = "auto";
    content.style.width = P.w + "px";
    content.style.height = "auto";
    content.style.position = "relative";
    content.style.transform = "none";
    const ptxt = $(".p-txt", content);
    // on a laptop only the text column scrolls, so the image never moves
    if (!phone) ptxt.classList.add("scrolls");

    const pairs = (phone && card ? [[".t", ".p-t"], [".s", ".p-s"], [".m .y", ".p-m .y"], [".m .f", ".p-m .f"]] : []).map(([a, b]) => {
      const ce = $(a, card!), pe = $(b, content);
      const k = fs(ce) / fs(pe);
      // the same measure in proportion to the type size, so every line breaks in the same place
      if (a === ".s") pe.style.width = rect(ce).w / k + "px";
      return { ce, pe, k };
    });
    if (!phone) {
      P.h = Math.min(content.offsetHeight, H - 64);
      P.y = Math.round((H - P.h) / 2);
      ptxt.style.maxHeight = P.h + "px";
    } else if (!card) {
      // a few lines of text: the sheet rises only as far as it needs to
      P.h = Math.min(content.offsetHeight, H - 10);
      P.y = H - P.h;
    }
    content.style.position = "";
    content.style.height = P.h + "px";
    frame.style.height = P.h + "px";
    frame.style.transform = `translate(${P.x}px, ${P.y}px)`;

    const cover = card && $(".cover", card), pimg = card && $(".p-img", content);
    let ghost: HTMLElement | null = null;
    if (card && !phone) {
      // a copy of the card's text rides under the growing image and fades, so no text crosses the image
      ghost = $(".txt", card).cloneNode(true) as HTMLElement;
      ghost.querySelectorAll("[id]").forEach((n) => n.removeAttribute("id"));
      ghost.setAttribute("aria-hidden", "true");
      content.appendChild(ghost);
      placeGhost(ghost, card);
    }
    S = {
      from, trigger, card, phone, P, pimg, gi: 0, ghost,
      rest: phone && card ? $$(".rest", content) : [...$$(".rest", content), ptxt],
      close: $(".p-close", content), bar: $(".p-bar", content), gal: phone ? $(".gal", content) : null, layers: [null, ...$$(".p-img .layer", content)],
      parts: pairs.map((p) => ({ ...p, C: rect(p.ce), L: rect(p.pe) })) as Part[],
      C: rect(from), Ci: cover && rect(cover), M: card && rect($(".p-media", content)), TL: phone || !card ? null : rect(ptxt).x,
      r0: card ? 16 : rect(from).h / 2, rP: phone ? 16 : 20, riC: cover && px(getComputedStyle(cover).borderTopLeftRadius), riP: 10,
      sp: new Spring(0, OMEGA, 4e-4), sd: new Spring(0, 26, 0.2), fn: null as Job | null, travel: null as number | null, closing: false,
    };
    if (card) wirePanel();
    $(".p-close", content).addEventListener("click", closePanel);
    from.style.visibility = "hidden";
    trigger.setAttribute("aria-expanded", "true");
    for (const el of inertTargets()) el.inert = true;
    render();
    overlay.style.visibility = "";
    if (reduced.matches) { S.sp.jump(1); render(); settle(); }
    else { S.sp.to(1, performance.now()); loop(); }
    S.close.focus({ preventScroll: true });
    history.pushState({ panel: true }, "");
    pushed = true;
  }

  function placeGhost(ghost: HTMLElement, card: HTMLElement) {
    const g = rect($(".txt", card)), c0 = rect(content);
    Object.assign(ghost.style, { position: "absolute", left: g.x - c0.x + "px", top: g.y - c0.y + "px", width: g.w + "px", height: g.h + "px", zIndex: "4", pointerEvents: "none", margin: "0" });
  }

  function wirePanel() {
    // the cover the card already loaded shows at once; the sharper panel-sized copy fades in over it when ready
    const hi = $<HTMLImageElement>(".p-img .hi img", content);
    const showHi = () => hi.parentElement!.classList.add("on");
    if (hi.complete && hi.naturalWidth) showHi(); else hi.addEventListener("load", showHi, { once: true });
    const caption = $(".cap", content), thumbs = $$<HTMLButtonElement>(".thumbs button", content);
    thumbs.forEach((b, i) => b.addEventListener("click", () => {
      thumbs.forEach((x, j) => x.setAttribute("aria-current", String(i === j)));
      S.gi = i;
      S.layers.forEach((l: HTMLElement | null, j: number) => l?.classList.toggle("on", j === i));
      if (S.layers[i]) $<HTMLImageElement>("img", S.layers[i]).loading = "eager";
      if (caption) caption.textContent = b.getAttribute("aria-label")!.replace(/^Show image \d+: /, "");
    }));
    if (S.gal) S.gal.addEventListener("scroll", () => {
      const i = Math.round(S.gal.scrollLeft / S.gal.clientWidth);
      S.gi = i;
      $$(".dots i", content).forEach((d, j) => d.classList.toggle("on", i === j));
      const b = thumbs[i];
      if (caption && b) caption.textContent = b.getAttribute("aria-label")!.replace(/^Show image \d+: /, "");
    }, { passive: true });
  }

  function travel() {
    if (!S.parts.length) return 0;
    if (S.travel == null) S.travel = Math.max(...S.parts.map((q: Part) => Math.hypot(q.C.x - q.L.x, q.C.y - q.L.y)));
    return S.travel;
  }
  function render() {
    const { P, parts, phone } = S;
    const p = S.sp.x, d = S.sd.x;
    const T = { x: P.x, y: P.y + d, w: P.w, h: P.h };
    const F = snapR(lerpRect(S.C, T, p));
    frame.style.transform = `translate(${F.x}px, ${F.y}px)`;
    frame.style.width = F.w + "px";
    frame.style.height = F.h + "px";
    const r = lerp(S.r0, S.rP, p), rb = phone ? lerp(S.r0, 0, p) : r;
    frame.style.borderRadius = `${r}px ${r}px ${rb}px ${rb}px`;
    frame.style.boxShadow = phone
      ? `0 0 0 1px ${isDark() ? `rgba(255,255,255,${0.075 * (1 - p)})` : `rgba(0,0,0,${0.065 * (1 - p)})`}`
      : isDark()
        ? `0 0 0 1px rgba(255,255,255,${lerp(0.075, 0.09, p)}), 0 30px 80px -24px rgba(0,0,0,${0.7 * p})`
        : `0 0 0 1px rgba(0,0,0,${lerp(0.065, 0.08, p)}), 0 2px 4px rgba(0,0,0,${0.04 * p}), 0 30px 80px -24px rgba(0,0,0,${0.3 * p})`;
    // the content stays put on screen while the frame grows around it
    content.style.transform = `translate(${T.x - F.x}px, ${T.y - F.y}px)`;
    for (const q of parts) {
      const x = lerp(q.C.x, q.L.x, p), y = lerp(q.C.y, q.L.y + d, p), k = lerp(q.k, 1, p);
      q.pe.style.transform = `translate(${x - q.L.x}px, ${Math.round(y) - q.L.y - d}px) scale(${k})`;
    }
    let clear = 1;
    if (S.card) {
      const M = { x: S.M.x, y: S.M.y + d, w: S.M.w, h: S.M.h };
      const I = lerpRect(S.Ci, M, p);
      const st = S.pimg.style;
      st.left = I.x - M.x + "px"; st.top = I.y - M.y + "px"; st.width = I.w + "px"; st.height = I.h + "px";
      st.borderRadius = lerp(S.riC, S.riP, p) + "px";
      if (S.closing && S.gi > 0) S.layers[S.gi].style.opacity = String(smooth(0.3, 0.85, p));
      if (S.ghost) {
        S.ghost.style.transform = `translate(${I.x - S.Ci.x}px, ${I.y + I.h - S.Ci.y - S.Ci.h}px)`;
        S.ghost.style.opacity = String(1 - smooth(0, 0.3, p));
      }
      // on a laptop the text column waits until the moving image has cleared it
      if (S.TL != null) clear = clamp(1 - (I.x + I.w - S.TL + 12) / 48);
    }
    // the details appear only once the moving text is within a few pixels of home;
    // a panel of text alone shows it only once the panel has nearly reached its size, so no line is cut off
    const fade = parts.length ? clamp(Math.min(1 - ((1 - p) * travel()) / 36, (p - 0.3) / 0.4))
      : S.card ? Math.min(smooth(0.4, 0.92, p), clear) : smooth(0.82, 1, p);
    const o = fade * fade * (3 - 2 * fade);
    for (const el of S.rest) { el.style.opacity = String(o); el.style.transform = `translateY(${(1 - o) * 6}px)`; }
    S.close.style.opacity = String(smooth(0.82, 1, p));
    if (S.bar) S.bar.style.opacity = String(o);
    dim.style.opacity = String(p * (1 - Math.min(1, d / (P.h * 0.85))));
  }
  function loop() {
    if (S.fn) return;
    S.fn = (now: number) => {
      if (!S) return true;
      S.sp.sample(now); S.sd.sample(now); render();
      if (S.sp.done && S.sd.done) { S.fn = null; settle(); return true; }
      return false;
    };
    run(S.fn);
  }
  function settle() {
    if (!S) return;
    if (S.sp.target === 1) {
      if (S.sd.x !== 0) return;
      for (const q of S.parts) q.pe.style.transform = "";
      content.style.transform = "";
      for (const el of S.rest) el.style.transform = "";
      if (S.phone) content.style.overflowY = "auto";
      if (S.gal) { S.gal.classList.add("on"); S.pimg.style.visibility = "hidden"; }
    } else finish(false);
  }
  function closePanel() {
    if (!S || (S.sp.target === 0 && !S.sp.done)) return;
    unpush();
    // the page takes clicks again as soon as the panel starts to close
    overlay.style.pointerEvents = "none";
    for (const el of inertTargets()) el.inert = false;
    const sc = content.scrollTop;
    content.style.overflowY = "";
    if (sc) { content.scrollTop = 0; $(".p-in", content).style.transform = `translateY(${-sc}px)`; }
    if (S.gal) {
      // the image returns to the card: show the current slide over the cover and fade it on the way
      if (S.gi > 0) S.layers[S.gi].classList.add("on");
      S.gal.classList.remove("on"); S.pimg.style.visibility = "";
    }
    S.pimg?.classList.add("noanim");
    S.closing = true;
    if (S.sp.done && S.sp.x === 1) {
      const d = S.sd.x;
      for (const q of S.parts) { q.pe.style.transform = ""; q.L = rect(q.pe); q.L.y -= d; }
      if (S.card) { const m = rect($(".p-media", content)); m.y -= d; S.M = m; }
    }
    // the row may have moved while the panel was open, so the panel returns to where the card is now
    S.C = rect(S.from);
    if (S.card) S.Ci = rect($(".cover", S.card));
    for (const q of S.parts) q.C = rect(q.ce);
    S.travel = null;
    if (S.ghost) placeGhost(S.ghost, S.card);
    if (reduced.matches) { finish(false); return; }
    S.sp.to(0, performance.now());
    loop();
  }
  function finish(instant: boolean) {
    if (!S) return;
    if (S.fn) stop(S.fn);
    const { from, trigger } = S as { from: HTMLElement; trigger: HTMLElement };
    from.style.visibility = "";
    trigger.setAttribute("aria-expanded", "false");
    for (const el of inertTargets()) el.inert = false;
    overlay.hidden = true;
    overlay.style.pointerEvents = "";
    content.replaceChildren();
    frame.removeAttribute("style");
    content.removeAttribute("style");
    dim.style.opacity = "0";
    document.documentElement.style.overflow = "";
    S = null;
    if (!instant) trigger.focus({ preventScroll: true });
    unpush();
    dispatchEvent(new Event("panel:closed"));
  }

  // Back while a panel is open closes it. The client router also acts on Back and would load this page
  // again, so the panel claims its own steps (and a later step forward onto one) through the gate in BaseHead.
  (window as any).claimBack = (e: PopStateEvent) => {
    const ours = pushed || steppingBack || S || e.state?.panel;
    pushed = steppingBack = false;
    if (S && !S.closing) closePanel();
    return !!ours;
  };

  // the drag on a phone sheet in progress, if any
  let drag: any = null;
  function endDrag(e: PointerEvent) {
    if (!drag || e.pointerId !== drag.id) return;
    const was = drag; drag = null;
    if (!was.active || !S) return;
    const a = was.samples[0], b = was.samples[was.samples.length - 1];
    const v = (b[1] - a[1]) / Math.max(1, b[0] - a[0]);
    if (S.sd.x > 120 || (v > 0.45 && S.sd.x > 24)) closePanel();
    else { S.sd.to(0, performance.now()); loop(); }
  }

  // Each page brings its own panel markup, cards and rows, so they are wired up again after every swap.
  onPage((signal) => {
    S = null;
    pushed = steppingBack = false;
    drag = null;
    rails = [];
    const el = document.getElementById("overlay");
    if (!el) return;
    overlay = el;
    dim = $("#dim");
    frame = $("#frame");
    content = $("#content");
    document.body.appendChild(overlay); // outside <main>, so the page behind can be made inert
    rails = $$("[data-rail]").map((sec) => new Rail(sec, signal));

    $$(".card .hit").forEach((h) => {
      const card = h.closest(".card") as HTMLElement;
      h.addEventListener("click", () => openPanel(card, h, $<HTMLTemplateElement>("template", card)));
    });
    // The whole hook opens it for a pointer; the button is the keyboard's way in, and a click on it bubbles here.
    const hook = $("[data-hook]"), intro = $<HTMLTemplateElement>("template[data-intro-panel]");
    if (hook && intro) {
      const plus = $(".plus", hook);
      hook.addEventListener("click", () => openPanel(plus, plus, intro));
    }
    dim.addEventListener("click", closePanel);
    // A link to another page replaces the panel's history entry, so Back from there returns to this page.
    content.addEventListener("click", (e) => {
      const a = (e.target as Element).closest("a[href]") as HTMLAnchorElement | null;
      if (!a || a.target || a.origin !== location.origin || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      pushed = false;
      navigate(a.href, { history: "replace" });
    });
    // Focus stays in the panel, even where Tab skips links and buttons, as in Safari by default.
    document.addEventListener("focusin", (e) => {
      if (S && !frame.contains(e.target as Node)) S.close.focus({ preventScroll: true });
    }, { signal });
    // The edge and shadow are set per frame, so a theme change while open draws them again.
    const themeWatch = new MutationObserver(() => S && render());
    themeWatch.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    signal.addEventListener("abort", () => themeWatch.disconnect());
    frame.addEventListener("dragstart", (e) => e.preventDefault());
    // iOS resizes the window by a toolbar's height when the toolbar collapses during a scroll; only a
    // larger change, such as a rotation or a resized window, closes the panel, since it no longer fits.
    let last = { w: innerWidth, h: innerHeight };
    addEventListener("resize", () => {
      if (innerWidth === last.w && Math.abs(innerHeight - last.h) < 120) return;
      last = { w: innerWidth, h: innerHeight };
      if (S) finish(true);
    }, { signal });
    addEventListener("keydown", (e) => {
      if (!S) return;
      if (e.key === "Escape") { e.preventDefault(); closePanel(); return; }
      if (e.key === "Tab") {
        const f = $$("button, a[href]", content).filter((x) => x.offsetParent);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }, { signal });

    /* phone: drag the sheet down to close */
    frame.addEventListener("pointerdown", (e) => {
      if (!S || !S.phone || S.sp.target !== 1 || e.button > 0) return;
      const onBar = (e.target as Element).closest(".p-bar, .p-media");
      if (!onBar && (content.scrollTop > 0 || (e.target as Element).closest("a, button"))) return;
      drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, active: false, samples: [[e.timeStamp, 0]], start: S.sd.x };
    });
    addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id || !S) return;
      const dy = e.clientY - drag.y0 + drag.start;
      if (!drag.active) {
        if (Math.abs(e.clientX - drag.x0) > Math.abs(e.clientY - drag.y0) + 2) { drag = null; return; }
        if (dy - drag.start < 6) { if (drag.start - dy > 6) drag = null; return; }
        drag.active = true;
        try { frame.setPointerCapture(e.pointerId); } catch (_) {}
        S.sd.jump(S.sd.x);
      }
      e.preventDefault();
      S.sd.jump(Math.max(0, dy));
      drag.samples.push([e.timeStamp, S.sd.x]);
      if (drag.samples.length > 6) drag.samples.shift();
      render();
    }, { signal });
    addEventListener("pointerup", endDrag, { signal });
    addEventListener("pointercancel", endDrag, { signal });
    content.addEventListener("scroll", () => { content.style.touchAction = content.scrollTop > 0 ? "pan-y" : "pan-down"; }, { passive: true });
  });

</script>
