---

<ul class="social">
  {
    SOCIAL.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          title={s.label}
          {...(s.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={ICONS[s.label]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }
  a:hover {
    color: var(--ink);
  }
  svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
</style>
