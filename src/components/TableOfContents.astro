---
/*
 * The essay's sections as a quiet rail in the left margin, with the section being read marked.
 * Wide screens only: on narrower screens there is no margin to hold it, and the essay reads
 * fine top to bottom without one.
 */
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const EXCLUDED = new Set(["footnotes", "references"]);
const items = Astro.props.headings.filter((h) => h.depth <= 2 && !EXCLUDED.has(h.slug));
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="Sections">
      <div class="toc-in">
        <p class="toc-title">Sections</p>
        <ol>
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<script>
  import { onPage } from "@/scripts/page";

  onPage((signal) => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let frame = 0;
    function mark() {
      frame = 0;
      const line = innerHeight * 0.3;
      let current = -1;
      targets.forEach((t, i) => {
        if (t && t.getBoundingClientRect().top < line) current = i;
      });
      links.forEach((a, i) => {
        if (i === current) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    }
    if (links.length) {
      addEventListener("scroll", () => (frame ||= requestAnimationFrame(mark)), { passive: true, signal });
      addEventListener("resize", () => (frame ||= requestAnimationFrame(mark)), { passive: true, signal });
      mark();
    }
  });
</script>

<style>
  .toc {
    display: none;
  }
  @media (min-width: 1240px) {
    .toc {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--g);
      width: calc(50% - var(--measure) / 2 - 64px - var(--g));
      max-width: 240px;
    }
  }
  .toc-in {
    position: sticky;
    top: 104px;
  }
  .toc-title {
    margin: 0 0 10px;
    font-size: 12.5px;
    line-height: 18px;
    font-weight: 500;
    color: var(--muted);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    margin-top: 2px;
  }
  a {
    display: block;
    padding: 4px 0;
    font-size: 13.5px;
    line-height: 19px;
    color: var(--muted);
    text-decoration: none;
    text-wrap: pretty;
    transition: color 0.2s var(--ease);
  }
  a:hover {
    color: var(--ink-2);
  }
  a[aria-current] {
    color: var(--ink);
  }
</style>
