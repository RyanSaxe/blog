---
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter500 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import inter600 from "@fontsource/inter/files/inter-latin-600-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Every page's text is in these three; preloading them keeps a new page from painting in a fallback font first. -->
{[inter400, inter500, inter600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<!-- The SVG follows the browser's light or dark theme; the .ico is for browsers without SVG icons. -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Ryan Saxe"
  href={new URL("rss.xml", Astro.site)}
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{ogImage && <meta property="twitter:image" content={ogImage} />}

<meta name="theme-color" content="#fafafa" />

<!--
  Sets data-theme on <html> before the page paints: the visitor's choice from the header toggle, or the
  device's setting until they make one. Dark image sources ([data-dark]) follow the theme rather than the
  device, including ones the panel clones in later. window.setTheme is the toggle's way in.
-->
<script is:inline>
  (() => {
    const root = document.documentElement;
    const device = matchMedia("(prefers-color-scheme: dark)");
    const meta = document.querySelector('meta[name="theme-color"]');
    const stored = () => {
      try {
        const t = localStorage.getItem("theme");
        return t === "light" || t === "dark" ? t : null;
      } catch {
        return null;
      }
    };
    const sync = (node) => {
      const media = root.dataset.theme === "dark" ? "all" : "not all";
      const fix = (s) => s.media !== media && (s.media = media);
      if (node.matches?.("source[data-dark]")) fix(node);
      node.querySelectorAll?.("source[data-dark]").forEach(fix);
      node.querySelectorAll?.("template").forEach((t) => sync(t.content));
    };
    const apply = (theme) => {
      root.dataset.theme = theme;
      meta?.setAttribute("content", theme === "dark" ? "#121214" : "#fafafa");
      sync(document);
    };
    apply(stored() ?? (device.matches ? "dark" : "light"));
    new MutationObserver((records) => {
      for (const r of records) for (const n of r.addedNodes) if (n.nodeType === 1) sync(n);
    }).observe(root, { childList: true, subtree: true });
    // a template's content is parsed outside the document, so the observer cannot see it
    document.addEventListener("DOMContentLoaded", () => sync(document));
    device.addEventListener("change", (e) => stored() || apply(e.matches ? "dark" : "light"));
    window.setTheme = (theme) => {
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      apply(theme);
    };
  })();

  // While a new page crossfades in, the browser sends every click to the page itself rather than the
  // link under the pointer. A press during the fade ends it, and its click goes to what is under it.
  (() => {
    let fade = null;
    let pressed = false;
    addEventListener("pagereveal", (e) => {
      fade = e.viewTransition;
      fade?.finished.finally(() => (fade = null));
    });
    addEventListener("pointerdown", () => {
      if (!fade) return;
      pressed = true;
      fade.skipTransition();
    }, true);
    addEventListener("click", (e) => {
      if (!pressed) return;
      pressed = false;
      if (e.target !== document.documentElement) return;
      const target = document.elementFromPoint(e.clientX, e.clientY)?.closest("a[href], button, [role=tab]");
      if (target) target.click();
    }, true);
  })();
</script>
