---
/* Career history from src/data/timeline.ts, grouped by organization, newest first. */
import { timeline, type TimelineEntry } from "@/data/timeline";

interface Group {
  organization: string;
  entries: TimelineEntry[];
}

const groups: Group[] = [];
for (const entry of timeline) {
  const last = groups.at(-1);
  if (last?.organization === entry.organization) last.entries.push(entry);
  else groups.push({ organization: entry.organization, entries: [entry] });
}

const yearOf = (date: string) => Number(date.slice(-4));
function span(group: Group) {
  const from = Math.min(...group.entries.map((e) => yearOf(e.startDate)));
  const current = group.entries.some((e) => !e.endDate);
  const to = current ? "Present" : String(Math.max(...group.entries.map((e) => yearOf(e.endDate!))));
  return `${from} – ${to}`;
}

function linkLabel(url: string) {
  if (url.includes("patents.google.com")) return `Patent ${url.split("/").filter(Boolean).at(-1)}`;
  if (url.includes("arxiv.org")) return "Paper on arXiv";
  return new URL(url).hostname.replace(/^www\./, "");
}
---

<ol class="career">
  {
    groups.map((group) => (
      <li class="group">
        <div class="org">
          <h3>{group.organization}</h3>
          <p>{span(group)}</p>
        </div>
        <ol class="roles">
          {group.entries.map((entry) => (
            <li class:list={["role", { now: !entry.endDate }]}>
              <div class="head">
                <h4>{entry.title}</h4>
                <p class="dates">
                  {entry.startDate} – {entry.endDate ?? "Present"}
                </p>
              </div>
              {entry.description && <p class="desc">{entry.description}</p>}
              {entry.link && (
                <a class="ext" href={entry.link} target="_blank" rel="noopener">
                  {linkLabel(entry.link)}
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                    <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .career {
    container-type: inline-size;
    margin: 0;
    padding: 4px 28px;
    list-style: none;
    background: var(--card);
    border-radius: 16px;
    box-shadow: var(--card-shadow);
  }
  .group {
    display: grid;
    grid-template-columns: 196px minmax(0, 1fr);
    column-gap: 24px;
    padding: 24px 0 22px;
  }
  .group + .group {
    border-top: 1px solid var(--line);
  }
  .org h3 {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    font-weight: 600;
    letter-spacing: -0.011em;
  }
  .org p {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .role {
    position: relative;
    padding-left: 24px;
  }
  .role + .role {
    margin-top: 20px;
  }
  /* The rail: one dot per role, joined by a hairline to the next role in the same organization. */
  .role::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-sizing: border-box;
    border: 1.5px solid var(--faint);
    background: var(--card);
  }
  .role.now::before {
    border-color: var(--ink);
    background: var(--ink);
  }
  .role:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 3.5px;
    top: 21px;
    bottom: -14px;
    width: 1px;
    background: var(--line);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
  }
  .head h4 {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    letter-spacing: -0.011em;
    text-wrap: balance;
  }
  .now .head h4 {
    font-weight: 600;
  }
  .dates {
    margin: 0;
    flex: none;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .desc {
    margin: 4px 0 0;
    max-width: 600px;
    font-size: 14.5px;
    line-height: 23px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .ext {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
    font-size: 14px;
    line-height: 22px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .ext:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ext svg {
    width: 11px;
    height: 11px;
  }

  @container (max-width: 700px) {
    .group {
      grid-template-columns: 148px minmax(0, 1fr);
      column-gap: 16px;
    }
  }
  @media (max-width: 640px) {
    .career {
      padding: 2px 18px;
    }
  }
  @container (max-width: 540px) {
    .group {
      display: block;
      padding: 20px 0 18px;
    }
    .org {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .head {
      display: block;
    }
    .dates {
      margin-top: 1px;
    }
  }
</style>
